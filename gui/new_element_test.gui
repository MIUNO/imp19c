types TEST_ELEMENTS {
	type new_element_test_window = widget {
		size = { 1920 1080 }
		filter_mouse = left|wheel|right
		alwaystransparent = no
		background = {
			shaderfile = "gfx/FX/pdxgui_default.shader"
			#using = white_background
			using = black_background
		}
		flowcontainer = {
			margin = { 20 20 }
			spacing = 10
			flowcontainer = {
				direction = vertical
				spacing = 10
				widget = {
					size = { 376 44 }
					state = {
						name = _mouse_enter
						on_start = "[PdxGuiWidget.FindChild('shiner').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('shiner').InterruptAnimation('pseudo_hide')]"

						on_start = "[PdxGuiWidget.FindChild('shiner').TriggerAnimation('pseudo_show')]"

						on_start = "[PdxGuiWidget.FindChild('left_deco').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco').InterruptAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco').InterruptAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco_item').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco_item').InterruptAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco_item').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco_item').InterruptAnimation('pseudo_hide')]"

						on_start = "[PdxGuiWidget.FindChild('left_deco').TriggerAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco').TriggerAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco_item').TriggerAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco_item').TriggerAnimation('pseudo_show')]"
					}
					
					state = {
						name = _mouse_enter
						on_start = "[PdxGuiWidget.FindChild('shiner').InterruptAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('shiner').InterruptAnimation('pseudo_show')]"

						on_start = "[PdxGuiWidget.FindChild('shiner').TriggerAnimation('pseudo_hide')]"

						on_start = "[PdxGuiWidget.FindChild('left_deco').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco').InterruptAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco').InterruptAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco_item').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco_item').InterruptAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco_item').InterruptAnimation('pseudo_show')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco_item').InterruptAnimation('pseudo_hide')]"

						on_start = "[PdxGuiWidget.FindChild('left_deco').TriggerAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco').TriggerAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('left_deco_item').TriggerAnimation('pseudo_hide')]"
						on_start = "[PdxGuiWidget.FindChild('right_deco_item').TriggerAnimation('pseudo_hide')]"
					}
					
					button = {
						name = "shiner"
						size = { 100% 100% }
						alpha = 0
						using = red_background
						modify_texture = {
							texture = "gfx/interface/base_parts/horizontal_gradient_stretch_black_double.dds"
							blend_mode = alphamultiply
						}		
						state = {
							name = pseudo_show
							animation = { alpha = 0.9 }
							duration = 0.15
						}
						state = {
							name = pseudo_hide
							animation = { alpha = 0 }
							duration = 0.15
						}
						parentanchor = center
						block "On_click" {}
						
						#Fontend buttons?
						block "ClickSound"
						{
							clicksound = "event:/SFX/UI/Generic/2.0/sfx_ui_button_primary"
							oversound = "event:/SFX/UI/Generic/2.0/sfx_ui_button_oversound"
						}
					}
					
					textbox = {
						autoresize = yes
						block "Text" { text = "Button Text" }
						using = Default_FontColor
						using = HeaderFont
						parentanchor = center
						fontsize = 26
						widget = {
							size = { 100% 100% }
							parentanchor = vcenter
							widget = {
								name = "left_deco"
								size = { 44 24 }
								position = { -50 0 }
								state = {
									name = pseudo_show
									position = { -58 0 }
									duration = 0.15
								}
								state = {
									name = pseudo_hide
									position = { -50 0 }
									duration = 0.15
								}
								icon = {
									size = { 44 24 }
									using = beige_background
									alpha = 0.2
									modify_texture = {
										texture = "gfx/interface/images/elements/side_pattern.dds"
										blend_mode = alphamultiply
										framesize = { 44 24 }
										frame = 1
									}
								}
								icon = {
									name = "left_deco_item"
									size = { 44 24 }
									using = gold_background
									alpha = 0
									state = {
										name = pseudo_show
										alpha = 0.9
										duration = 0.15
									}
									state = {
										name = pseudo_hide
										alpha = 0
										duration = 0.15
									}
									modify_texture = {
										texture = "gfx/interface/images/elements/side_pattern.dds"
										blend_mode = alphamultiply
										framesize = { 44 24 }
										frame = 1
									}
								}
							}
							widget = {
								name = "right_deco"
								size = { 44 24 }
								parentanchor = right
								position = { 50 0 }
								state = {
									name = pseudo_show
									position = { 58 0 }
									duration = 0.15
								}
								state = {
									name = pseudo_hide
									position = { 50 0 }
									duration = 0.15
								}
								icon = {
									size = { 44 24 }
									using = beige_background
									alpha = 0.2
									modify_texture = {
										texture = "gfx/interface/images/elements/side_pattern.dds"
										blend_mode = alphamultiply
										framesize = { 44 24 }
										frame = 2
									}
								}
								icon = {
									name = "right_deco_item"
									size = { 44 24 }
									using = gold_background
									alpha = 0
									state = {
										name = pseudo_show
										alpha = 0.9
										duration = 0.15
									}
									state = {
										name = pseudo_hide
										alpha = 0
										duration = 0.15
									}
									modify_texture = {
										texture = "gfx/interface/images/elements/side_pattern.dds"
										blend_mode = alphamultiply
										framesize = { 44 24 }
										frame = 2
									}
								}
							}
						}
						widget = {
							visible = no
							size = { 100% 24 }
							parentanchor = center
							background = {
								shaderfile = "gfx/FX/pdxgui_default.shader"
								using = beige_background
								margin = { 50 0 }
								alpha = 0.2
								modify_texture = {
									texture = "gfx/interface/images/elements/side_pattern.dds"
									blend_mode = alphamultiply
									spriteType = corneredtiled
									spriteborder = { 44 24 }
								}
							}
						}
						widget = {
							visible = no
							#name = "shiner2"
							size = { 100% 24 }
							parentanchor = center
							alpha = 0.0
							state = {
								name = pseudo_show
								animation = {
									alpha = 0.9
								}
								duration = 0.15
							}
							state = {
								name = pseudo_hide
								animation = {
									alpha = 0.0
								}
								duration = 0.15
							}
							background = {
								shaderfile = "gfx/FX/pdxgui_default.shader"
								using = gold_background
								margin = { 50 0 }
								modify_texture = {
									texture = "gfx/interface/images/elements/side_pattern.dds"
									blend_mode = alphamultiply
									spriteType = corneredtiled
									spriteborder = { 44 24 }
								}
							}
						}
					}
				}
				margin_widget = {
					size = { 320 36 }
					margin = { 0 2 }
					widget = {
						size = { 100% 100% }
						using = background_widget
					}
					button = {
						size = { 100% 100% }
						block "Visible_close" { visible = "[Not(GetVariableSystem.HasValue( 'test_tab_button', 'true' ))]" }
						block "On_click_open" { onclick = "[GetVariableSystem.Set( 'test_tab_button', 'true' )]" }
						using = beige_background
						alpha = 0.15
					}
					button = {
						size = { 100% 100% }
						block "Visible_open" { visible = "[GetVariableSystem.HasValue( 'test_tab_button', 'true' )]" }
						block "On_click_close" { onclick = "[GetVariableSystem.Set( 'test_tab_button', 'false' )]" }
						using = beige_background
						alpha = 0.15
					}
					widget = {
						size = { 100% 100% }
						alpha = 0.9
						icon = {
							size = { 8 11 }
							position = { 8 0 }
							parentanchor = vcenter
							using = gold_background
							block "Visible_open" { visible = "[GetVariableSystem.HasValue( 'test_tab_button', 'true' )]" }
							modify_texture = {
								texture = "gfx/interface/base_parts/arrow_right.dds"
								blend_mode = alphamultiply
							}
						}
						icon = {
							size = { 11 8 }
							position = { 8 0 }
							parentanchor = vcenter
							using = gold_background
							block "Visible_close" { visible = "[Not(GetVariableSystem.HasValue( 'test_tab_button', 'true' ))]" }
							modify_texture = {
								texture = "gfx/interface/base_parts/arrow.dds"
								blend_mode = alphamultiply
							}
						}
						textbox = {
							position = { 24 0 }
							parentanchor = vcenter				
							autoresize = yes
							using = BaseFontS
							using = Highlight_FontColor
							block "Title_text" { text = "Test tab button" }
							max_width = 230
							fontsize_min = 11
							elide = right
						}
						margin_widget = {
							size = { 100% 1 }
							margin = { 5 0 }
							position = { 0 -3 }
							parentanchor = bottom
							icon = {
								size = { 100% 100% }
								using = gold_background
							}
						}
					}
				}
				text_button_square_highlighted_inner = {
					visible = "[HasDlc('Heirs of Alexander')]"
					enabled = "[ProvinceWindow.CanBuildGreatWork]"
					size = { 200 60 }
					parentanchor = right|vcenter
					blockoverride "Border" { texture = "gfx/interface/base_parts/new_elements/border_2.dds" }
					blockoverride "BorderShadow" { texture = "gfx/interface/base_parts/new_elements/border_2_shadow.dds" }
					blockoverride "BorderSideDeco" { texture = "gfx/interface/base_parts/new_elements/border_2_deco.dds" }
					blockoverride "BaseSmall" { texture = "gfx/interface/base_parts/new_elements/border_2_small_base.dds" }
					blockoverride "BaseNormal" { texture = "gfx/interface/base_parts/new_elements/border_2_normal_base.dds" }
					blockoverride "On_click" { onclick = "[ProvinceWindow.OpenGreatWorkWindowBuild]" }
					blockoverride "mouse_enter" {
						on_start = "[PdxGuiWidget.AccessParent.FindChild('statue_of_liberty').TriggerAnimation('show')]"
						on_start = "[PdxGuiWidget.AccessParent.FindChild('great_sphinx_of_giza').TriggerAnimation('show')]"
						on_start = "[PdxGuiWidget.AccessParent.FindChild('tower_eiffel').TriggerAnimation('show')]"
						on_start = "[PdxGuiWidget.AccessParent.FindChild('mayan_pyramid').TriggerAnimation('show')]"
					}
					blockoverride "mouse_leave" {
						on_start = "[PdxGuiWidget.AccessParent.FindChild('statue_of_liberty').TriggerAnimation('hide')]"
						on_start = "[PdxGuiWidget.AccessParent.FindChild('great_sphinx_of_giza').TriggerAnimation('hide')]"
						on_start = "[PdxGuiWidget.AccessParent.FindChild('tower_eiffel').TriggerAnimation('hide')]"
						on_start = "[PdxGuiWidget.AccessParent.FindChild('mayan_pyramid').TriggerAnimation('hide')]"
					}
					blockoverride "Decoration" {
						textbox = {
							parentanchor = center
							position = { 0 -15 }
							using = HeaderFont
							using = Highlight_FontColor
							autoresize = yes
							align = center
							text = "OPEN_GREAT_WORKS"
						}
						margin_widget = {
							name = deco
							size = { 100% 100% }
							margin = { 3 3 }
							icon = {
								size = { 100% 10 }
								parentanchor = bottom
								shaderfile = "gfx/FX/pdxgui_scroll.shader"
								effectname = "dark_3"
								using = gold_background
								modify_texture = {
									texture = "gfx/interface/base_parts/new_elements/icons/plate_1.dds"
									blend_mode = alphamultiply
								}
							}
							widget = {
								size = { 100% 40 }
								parentanchor = bottom
								widget = {
									name = statue_of_liberty
									size = { 40 40 }
									parentanchor = hcenter
									position = { -40 0 }
									state = {
										name = show
										position = { -50 0 }
										duration = 0.1
									}
									state = {
										name = hide
										position = { -40 0 }
										duration = 0.1
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_2"
										using = shadow_background
										alpha = 0.25
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/statue_of_liberty_shadow.dds"
											blend_mode = alphamultiply
										}
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_2"
										using = gold_background
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/statue_of_liberty.dds"
											blend_mode = alphamultiply
										}
									}
								}
								widget = {
									name = great_sphinx_of_giza
									size = { 40 40 }
									parentanchor = hcenter
									position = { -75 0 }
									state = {
										name = show
										position = { -80 0 }
										duration = 0.1
									}
									state = {
										name = hide
										position = { -75 0 }
										duration = 0.1
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_1"
										using = shadow_background
										alpha = 0.25
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/great_sphinx_of_giza_shadow.dds"
											blend_mode = alphamultiply
										}
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_1"
										using = gold_background
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/great_sphinx_of_giza.dds"
											blend_mode = alphamultiply
										}
									}
								}
								widget = {
									name = tower_eiffel
									size = { 40 40 }
									parentanchor = hcenter
									position = { 40 3 }
									state = {
										name = show
										position = { 50 3 }
										duration = 0.1
									}
									state = {
										name = hide
										position = { 40 3 }
										duration = 0.1
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_2"
										using = shadow_background
										alpha = 0.25
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/tower_eiffel_shadow.dds"
											blend_mode = alphamultiply
										}
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_2"
										using = gold_background
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/tower_eiffel.dds"
											blend_mode = alphamultiply
										}
									}
								}
								widget = {
									name = mayan_pyramid
									size = { 40 40 }
									parentanchor = hcenter
									position = { 75 3 }
									state = {
										name = show
										position = { 80 3 }
										duration = 0.1
									}
									state = {
										name = hide
										position = { 75 3 }
										duration = 0.1
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_1"
										using = shadow_background
										alpha = 0.25
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/mayan_pyramid_shadow.dds"
											blend_mode = alphamultiply
										}
									}
									icon = {
										size = { 100% 100% }
										shaderfile = "gfx/FX/pdxgui_scroll.shader"
										effectname = "dark_1"
										using = gold_background
										modify_texture = {
											texture = "gfx/interface/base_parts/new_elements/icons/mayan_pyramid.dds"
											blend_mode = alphamultiply
										}
									}
								}
							}
							widget = {
								name = front_waves
								size = { 100% 5 }
								parentanchor = bottom
								icon = {
									size = { 100% 100% }
									using = shadow_background
									alpha = 0.25
									modify_texture = {
										texture = "gfx/interface/base_parts/new_elements/icons/plate_1_shadow.dds"
										blend_mode = alphamultiply
									}
								}
								icon = {
									size = { 100% 100% }
									using = gold_background
									modify_texture = {
										texture = "gfx/interface/base_parts/new_elements/icons/plate_1.dds"
										blend_mode = alphamultiply
									}
								}
							}
						}
					}
					blockoverride "Center_text" { visible = no }
					tooltip = "[ProvinceWindow.CanBuildGreatWorkTooltip]"
				}
			}
		}
	}
}